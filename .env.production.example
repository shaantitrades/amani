# =============================================================================
# BODOGUI - variables de PRODUCTION (a coller dans Coolify > Environment)
# Les valeurs marquees TODO doivent etre remplacees avant le premier deploiement.
#
# ATTENTION : Coolify (mode Docker Compose) ne transmet au conteneur `api` que
# les variables listees dans `environment:` de docker-compose.yml. Ajouter une
# variable ici ne suffit pas : il faut aussi l'ajouter la-bas (ex. WHATSAPP_*,
# SMS_FALLBACK_PROVIDER, SMS_HTTP_*), sinon l'API ne la voit pas.
# =============================================================================

POSTGRES_USER=bodogui
# TODO : mot de passe fort HEXADECIMAL (openssl rand -hex 24) : il est insere tel quel dans DATABASE_URL
POSTGRES_PASSWORD=
POSTGRES_DB=bodogui

# TODO : secret de signature des jetons (openssl rand -hex 32)
JWT_SECRET=
JWT_TTL=30d

# Domaines publics
PUBLIC_WEB_URL=https://bodogui.com
PUBLIC_API_URL=https://api.bodogui.com
CORS_ORIGINS=https://bodogui.com,https://app.bodogui.com

LOG_LEVEL=info

# --- Envoi des codes et des alertes (SMS / WhatsApp) -------------------------
# Recommande au Tchad : WhatsApp (Meta Cloud API) en principal, SMS en secours.
# Le canal console n'envoie rien mais ecrit le code dans les logs du service api.
SMS_PROVIDER=console
SMS_FALLBACK_PROVIDER=none
SMS_SENDER_ID=BODOGUI

# WhatsApp (Meta Cloud API) : voir docs/ENVIRONMENT.md, « Envoyer les codes par
# WhatsApp ». WHATSAPP_PHONE_ID = « Phone number ID » (console Meta > API Setup),
# WHATSAPP_TOKEN = jeton d'utilisateur systeme (permanent). WHATSAPP_TEMPLATE =
# modele valide, obligatoire hors fenetre de 24 h : le CODE part dans {{1}}.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=fr
WHATSAPP_API_VERSION=v21.0

# SMS classique : Africa's Talking couvre le Tchad (a confirmer aupres du support)
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
# Passerelle HTTP generique (SMS_PROVIDER=http ou SMS_FALLBACK_PROVIDER=http)
SMS_HTTP_URL=
SMS_HTTP_METHOD=POST
SMS_HTTP_HEADERS=
SMS_HTTP_BODY=
OTP_PER_PHONE_PER_HOUR=5

# --- Connexion de test (recette sur le site deploye) --------------------------
# Code fixe pour des numeros autorises, sans passerelle SMS : permet d'entrer
# dans l'application avant l'ouverture du compte Africa's Talking.
# A LAISSER VIDE des que les SMS fonctionnent (voir docs/DEPLOYMENT.md § 7).
# Exemple : TEST_LOGIN_PHONES=+23566000001,+23566123456  /  TEST_LOGIN_CODE=12345
TEST_LOGIN_PHONES=
TEST_LOGIN_CODE=

# --- Stockage medias : Backblaze B2 + Cloudflare CDN ------------------------
STORAGE_DRIVER=b2
B2_KEY_ID=
B2_APP_KEY=
B2_BUCKET=bodogui-media
B2_REGION=eu-central-003
S3_BUCKET=bodogui-media
# Necessaire uniquement si vous passez par MinIO en preproduction
# S3_ENDPOINT=https://s3.eu-central-003.backblazeb2.com

# --- Speech-to-Text (Phase 2, laisser none au MVP) --------------------------
STT_PROVIDER=none
WHISPER_URL=
GOOGLE_STT_API_KEY=

# --- Notifications push PWA (npx web-push generate-vapid-keys) --------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@bodogui.com

# --- Moderation --------------------------------------------------------------
FRAUD_AUTO_HIDE_REPORTS=3

# --- Backups (cron Coolify, voir ops/backup.sh) -----------------------------
BACKUP_DIR=/data/backups
B2_BACKUP_BUCKET=bodogui-backups
BACKUP_RETENTION_DAYS=14
