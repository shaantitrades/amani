# =============================================================================
# BODOGUI - variables d'environnement (a definir dans Coolify > Environment)
# Copier ce fichier en .env pour le developpement local.
# =============================================================================

# --- General ----------------------------------------------------------------
NODE_ENV=development
APP_NAME=Bodogui
# Origines autorisees pour le frontend (separes par des virgules)
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
PUBLIC_WEB_URL=http://localhost:5173
# URL publique de l'API (utilisee dans les SMS et les liens profonds)
PUBLIC_API_URL=http://localhost:4000

# --- Base de donnees (PostgreSQL) -------------------------------------------
# En local : postgres://bodogui:bodogui@localhost:5432/bodogui
# Sur Coolify : postgres://<user>:<pass>@<service-db-interne>:5432/bodogui
DATABASE_URL=postgres://bodogui:bodogui@localhost:5432/bodogui
POSTGRES_USER=bodogui
POSTGRES_PASSWORD=bodogui
POSTGRES_DB=bodogui
PGSSLMODE=disable
DB_POOL_MAX=10

# --- Cache / files d'attente (Redis) ----------------------------------------
REDIS_URL=redis://localhost:6379

# --- Authentification -------------------------------------------------------
JWT_SECRET=change-me-with-openssl-rand-hex-32
JWT_TTL=30d
REFRESH_TTL_DAYS=180
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_PER_PHONE_PER_HOUR=5
OTP_PER_IP_PER_HOUR=30
# En dev : renvoie le code SMS dans la reponse HTTP pour tester sans passerelle
OTP_DEV_ECHO=true

# --- SMS --------------------------------------------------------------------
# console | africastalking | twilio
SMS_PROVIDER=console
SMS_SENDER_ID=BODOGUI
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# --- Stockage medias (S3 compatible) ----------------------------------------
# local | minio | b2
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./var/storage
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=bodogui-media
S3_ACCESS_KEY_ID=bodogui
S3_SECRET_ACCESS_KEY=bodogui-secret
# Backblaze B2 (production) : S3_ENDPOINT=https://s3.eu-central-003.backblazeb2.com
B2_KEY_ID=
B2_APP_KEY=
B2_BUCKET=bodogui-media
B2_REGION=eu-central-003
# Taille maximale d'un fichier envoye
MAX_PHOTO_BYTES=5242880
MAX_AUDIO_BYTES=1048576
MAX_PHOTOS_PER_AD=6

# --- Traitement d'image / audio ---------------------------------------------
IMAGE_MAX_WIDTH=1080
IMAGE_WEBP_QUALITY=62
IMAGE_TARGET_BYTES=102400

# --- Transcription vocale (optionnel, Phase 2) ------------------------------
# none | local | google
STT_PROVIDER=none
WHISPER_URL=http://localhost:9000/asr
GOOGLE_STT_API_KEY=

# --- Notifications push (PWA) ------------------------------------------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@bodogui.com

# --- Backups -----------------------------------------------------------------
BACKUP_DIR=/data/backups
B2_BACKUP_BUCKET=bodogui-backups
BACKUP_RETENTION_DAYS=14

# --- Divers ------------------------------------------------------------------
# Sous-traitement : affiche les logs SQL en dev
LOG_LEVEL=info
FRAUD_AUTO_HIDE_REPORTS=3
